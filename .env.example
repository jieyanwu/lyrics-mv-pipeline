# ============================================
# Lyrics MV Pipeline 环境变量配置
# 复制为 .env 并填入你的凭证
# ⚠️ 不要把 .env 提交到 Git！
# ============================================

# ─── B站上传 ───
# Cookie文件路径（从浏览器F12导出）
BILI_COOKIE_FILE=./cookies.json

# ─── 网易云音乐 ───
# VIP账号Cookie（可选，用于下载付费歌曲）
# 获取方法: 浏览器登录 music.163.com → F12 → Application → Cookies
NETEASE_COOKIE=

# ─── AI 功能（可选）───
# OpenAI兼容接口
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# ─── 视频生成 ───
# Lrc2Video Gradio 服务地址
LRC2VIDEO_URL=http://localhost:7860

# 默认视频参数
DEFAULT_FONT_FAMILY=NotoSansSC
DEFAULT_FONT_SIZE=36
DEFAULT_FONT_COLOR=#FFFFFF
DEFAULT_OUTLINE_COLOR=#000000
DEFAULT_OUTLINE_WIDTH=3
DEFAULT_BG_COLOR=#1a1512
DEFAULT_RESOLUTION=1920x1080

# ─── 网站部署 ───
# 网页输出目录
WEB_DIR=./web_output

# ─── 归档 ───
# 归档根目录
ARCHIVE_DIR=./archive
